# =============================================================================
# VIGT Clone Automation — central environment file
# Copy this file to `.env` in the repo root and adjust values.
# Used by: Streamlit frontend, FastAPI backend (agent vars optional for UI-only).
# =============================================================================

# --- Logging (all Python services) ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vigt
DB_USER=vigt
DB_PASSWORD=change-me
DB_MIN_CONN=1
DB_MAX_CONN=10

# --- FastAPI backend ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
API_KEY=
REQUIRE_API_KEY=false
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOG_ALLOWED_ROOTS=/u02/shared
ALLOW_LOG_URL_REDIRECT=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60
ENABLE_DOCS=false
API_MAX_RUN_LIMIT=200
PROTECTED_TARGET_ENV_NAME=PROD

# --- Streamlit frontend (HTTP client timeouts) ---
API_HEALTH_TIMEOUT_SEC=2
API_GET_TIMEOUT_SEC=5
API_POST_TIMEOUT_SEC=10
RUN_DETAILS_REFRESH_SEC=3

# --- Target agent (only required when running agent.py) ---
INSTANCE_ENV_ID=2
INSTANCE_DBNAME=
MASTER_CLONE_SH=
SKIP_FUNCTION_SH=
NULLIFY_CLONE_SH=
ABORT_CLONE_SH=
POLL_INTERVAL_SEC=10
INSTANCE_CLONE_DIR=
CLONE_LOG=
SUBPROCESS_TIMEOUT_SEC=0
LOG_LOCATION_MAX_LEN=100
